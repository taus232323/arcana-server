# SMTP / registration settings used by the deployment docs.
CONTINUWUITY_SMTP__CONNECTION_URI=
CONTINUWUITY_SMTP__SENDER=
CONTINUWUITY_SMTP__REQUIRE_EMAIL_FOR_REGISTRATION=true
CONTINUWUITY_SMTP__REQUIRE_EMAIL_FOR_TOKEN_REGISTRATION=true

# Optional: Google Play review account fixed OTP (exactly 4 digits).
# Also set [global.play_review].emails in continuwuity.toml.
# CONTINUWUITY_PLAY_REVIEW__CODE=

# Client download links shown on the landing page and invite page.
# Fill these with Google Drive now, then swap them to store links later.
CONTINUWUITY_WELL_KNOWN__ANDROID_STORE_DOWNLOAD=
CONTINUWUITY_WELL_KNOWN__ANDROID_FDROID_DOWNLOAD=
CONTINUWUITY_WELL_KNOWN__IOS_DOWNLOAD=

# LiveKit / Element Call (MSC4143). Generate with:
#   docker run --rm livekit/livekit-server:latest generate-keys
# Also put the same values into deploy/livekit.yaml (see livekit.yaml.example).
LIVEKIT_KEY=
LIVEKIT_SECRET=
