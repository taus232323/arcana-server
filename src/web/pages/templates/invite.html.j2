{% extends "_layout.html.j2" %}

{%- block title -%}
Приглашение в Arcana
{%- endblock -%}

{%- block head -%}
<link rel="stylesheet" href="/_continuwuity/resources/index.css">
{%- endblock -%}

{%- block content -%}
<div class="panel landing-panel">
    <section class="hero">
        <div class="hero-brand">
            <img class="hero-logo" src="/_continuwuity/resources/icon-512.png" alt="Arcana">
            <p class="brand-name">Arcana</p>
            <h1>Вас пригласили</h1>
            <p class="hero-copy">
                Откройте приглашение в приложении
                {%- if has_inviter %}
                — от <span class="token-chip">{{ inviter }}</span>
                {%- endif %}.
            </p>

            <div class="download-row">
                <a class="cta primary" href="arcana://invite/{{ token }}?web={{ client_domain }}/invite/{{ token }}">Открыть в Arcana</a>
            </div>

            <p class="hero-copy subtle">Нет приложения? Скачайте и вернитесь к этой ссылке.</p>

            <div class="store-row" aria-label="Ссылки на скачивание">
                {%- if let Some(url) = android_store_download %}
                <a class="store-link" href="{{ url }}">
                    <span class="store-mark android" aria-hidden="true">A</span>
                    <span class="store-copy">
                        <span class="store-label">Android</span>
                        <span class="store-meta">скачать</span>
                    </span>
                </a>
                {%- else %}
                <span class="store-link disabled" aria-hidden="true">
                    <span class="store-mark android">A</span>
                    <span class="store-copy">
                        <span class="store-label">Android</span>
                        <span class="store-meta">скоро</span>
                    </span>
                </span>
                {%- endif %}
                {%- if let Some(url) = android_fdroid_download %}
                <a class="store-link" href="{{ url }}">
                    <span class="store-mark huawei" aria-hidden="true">F</span>
                    <span class="store-copy">
                        <span class="store-label">F-Droid</span>
                        <span class="store-meta">APK / Huawei</span>
                    </span>
                </a>
                {%- else %}
                <span class="store-link disabled" aria-hidden="true">
                    <span class="store-mark huawei">F</span>
                    <span class="store-copy">
                        <span class="store-label">F-Droid</span>
                        <span class="store-meta">скоро</span>
                    </span>
                </span>
                {%- endif %}
                {%- if let Some(url) = ios_download %}
                <a class="store-link" href="{{ url }}">
                    <span class="store-mark ios" aria-hidden="true">i</span>
                    <span class="store-copy">
                        <span class="store-label">iOS</span>
                        <span class="store-meta">скачать</span>
                    </span>
                </a>
                {%- else %}
                <span class="store-link disabled" aria-hidden="true">
                    <span class="store-mark ios">i</span>
                    <span class="store-copy">
                        <span class="store-label">iOS</span>
                        <span class="store-meta">скоро</span>
                    </span>
                </span>
                {%- endif %}
            </div>

            <p class="fine-print">
                <a href="/privacy">Политика конфиденциальности</a>
                ·
                <a href="/terms">Условия использования</a>
            </p>
        </div>
    </section>
</div>
{%- endblock content -%}
