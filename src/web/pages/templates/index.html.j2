{% extends "_layout.html.j2" %}

{%- block title -%}
Arcana
{%- endblock -%}

{%- block head -%}
<link rel="stylesheet" href="/_continuwuity/resources/index.css">
{%- endblock -%}

{%- block content -%}
<div class="panel landing-panel">
    <section class="hero">
        <div class="hero-grid">
            <div class="hero-brand">
                <span class="hero-badge">Arcana messenger</span>
                <img class="hero-logo" src="/_continuwuity/resources/logo.svg" alt="">
                <h1>Install Arcana</h1>
                <p class="hero-copy">
                    Open invite links in the app when it is installed. If not, this page gives you the Android downloads and the next step into the client.
                </p>
                {%- if first_run %}
                <p class="fine-print">
                    This server is still in first-run mode. Create the first account from the admin room, then come back here to install the client.
                </p>
                {%- endif %}
                <div class="cta-row">
                    {%- if let Some(url) = android_fdroid_download %}
                    <a class="cta primary" href="{{ url }}">Download for F-Droid</a>
                    {%- else %}
                    <span class="cta primary disabled">F-Droid download coming soon</span>
                    {%- endif %}
                    {%- if let Some(url) = android_gdroid_download %}
                    <a class="cta secondary" href="{{ url }}">Download for G-Droid</a>
                    {%- else %}
                    <span class="cta secondary disabled">G-Droid download coming soon</span>
                    {%- endif %}
                </div>
                <p class="fine-print">
                    {%- if let Some(url) = ios_download %}
                    iPhone download: <a href="{{ url }}">open the store page</a>.
                    {%- else %}
                    iPhone support will link to the store once the app is published.
                    {%- endif %}
                </p>
                <p class="fine-print">
                    Invite URLs follow the shape <span class="token-chip">{{ client_domain }}/invite/&lt;token&gt;</span>.
                </p>
            </div>

            <aside class="feature-grid" aria-label="What to expect">
                <div class="feature-card">
                    <h2>Invite links stay Arcana-first</h2>
                    <p>Arcana invite URLs open the app directly when installed, and fall back to this site when they do not.</p>
                </div>
                <div class="feature-card">
                    <h2>Compatibility stays behind the scenes</h2>
                    <p>The server can keep its transport layer internal, while the public flow stays on Arcana pages and Arcana links.</p>
                </div>
                <div class="feature-card">
                    <h2>Clean onboarding</h2>
                    <p>One landing page for first install now, and later store links without changing the invite shape.</p>
                </div>
                <div class="feature-card">
                    <h2>Connect to your server</h2>
                    <p>Use <span class="token-chip">{{ server_name }}</span> as your homeserver once the client is installed.</p>
                </div>
            </aside>
        </div>
    </section>
</div>
{%- endblock content -%}
