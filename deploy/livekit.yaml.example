# Copy to livekit.yaml and replace LIVEKIT_KEY / LIVEKIT_SECRET.
# Generate with: docker run --rm livekit/livekit-server:latest generate-keys

port: 7880
bind_addresses:
  - "127.0.0.1"
rtc:
  tcp_port: 7881
  port_range_start: 50100
  port_range_end: 50200
  use_external_ip: true
  enable_loopback_candidate: false
keys:
  LIVEKIT_KEY: LIVEKIT_SECRET
turn:
  enabled: true
  udp_port: 3478
  relay_range_start: 50300
  relay_range_end: 50400
  domain: arcana.celesteai.ru
